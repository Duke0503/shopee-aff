# Copy to .env and fill in once you have the accounts.
# Everything here is optional: with all values blank the system still runs,
# using a Shopee simulator and printing Zalo messages to stdout.

# ---------------------------------------------------------------
# Shopee Affiliate Open API
# Find it at: affiliate.shopee.vn -> home page -> "Open API" section
# Blank = simulated mode, no calls leave the machine
# ---------------------------------------------------------------
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.vn/graphql

# ---------------------------------------------------------------
# Zalo Bot API (official, free, works in group chats)
# Get a token: open Zalo -> find the "Zalo Bot Manager" OA -> Create bot
# Blank = messages print to stdout instead of being sent
# ---------------------------------------------------------------
ZALO_BOT_TOKEN=
ZALO_API_URL=https://bot-api.zaloplatforms.com

# ---------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------
# Share of the APPROVED commission promised to the customer.
CASHBACK_RATE=0.80

# Who absorbs the 10% Shopee withholds at source?
#
#   owner_absorbs - you absorb it. Customers always receive CASHBACK_RATE.
#                   You keep roughly 9% of gross commission.
#
#   user_absorbs  - deducted from the customer's cashback. You keep roughly
#                   19%. WARNING: above ~2,000,000 VND per payout every
#                   period is withheld, so customers never receive
#                   CASHBACK_RATE. Advertise the lower figure or do not use
#                   this policy. Run `cashback check-policy` for the numbers.
TAX_POLICY=owner_absorbs

# Shopee's attribution window. A link request with no order after this many
# days is marked expired.
LINK_ATTRIBUTION_DAYS=7

# Transfer automatically once an order is approved, or wait for the customer
# to ask? Waiting earns more from customers who forget; paying automatically
# earns trust. Choose deliberately.
AUTO_PAYOUT=true

# ---------------------------------------------------------------
DB_PATH=./cashback.db

# ---------------------------------------------------------------
# Local bridge for the browser helper extension
# Only used when Open API access has not been granted.
# ---------------------------------------------------------------
BRIDGE_PORT=8787
# Shared secret between the bridge and the extension. Set any long random
# string; the extension must send it in the X-Bridge-Token header.
BRIDGE_TOKEN=

# Micro-batching: hold requests until the oldest has waited this long, or
# the queue reaches BATCH_MAX_SIZE, whichever comes first. A burst of
# requests then collapses into one browser pass.
BATCH_WINDOW_SECONDS=150
BATCH_MAX_SIZE=20

# ---------------------------------------------------------------
# Per-product commission lookup (third party)
# ---------------------------------------------------------------
# Shows the customer an estimated cashback amount when the link is sent.
#
# It calls data.addlivetag.com, whose every response declares:
#     "purpose": "for_education_research_internal_non_commercial"
#     "nonCommercialOnly": true
#
# A cashback business is commercial use, so this is OFF by default.
# Turning it on is a deliberate choice against the provider's stated
# terms. The clean alternative is Shopee's own Open API.
PRODUCT_LOOKUP_ENABLED=false

# Shortest gap between two browser passes. Bounds how often Shopee is
# touched; when the browser is idle a waiting customer is served at once.
BATCH_MIN_GAP_SECONDS=20

# How often serve pulls the conversion report in, and how far back it looks.
RECONCILE_INTERVAL_MINUTES=60
RECONCILE_DAYS=90
