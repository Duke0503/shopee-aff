{
  "manifest_version": 3,
  "name": "Cashback Bridge (new platform)",
  "version": "0.1.0",
  "description": "Takes one link job at a time from the cashback server on this machine and makes the link on the Shopee Affiliate custom link page.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["https://affiliate.shopee.vn/*", "http://127.0.0.1/*", "https://s.shopee.vn/*", "https://shopee.vn/*", "https://shope.ee/*", "https://*.shp.ee/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Cashback Bridge settings" }
}
