{
  "name": "@mmo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Architecture v2 backend: NestJS + Fastify, Drizzle over the shared SQLite file.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:pull": "drizzle-kit pull",
