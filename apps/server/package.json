{
  "name": "@cashback/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one server: seven modules, the two listeners, the jobs, the only writer of the ledger database.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:start": "tsx src/dev-start.ts",
    "dev:stop": "tsx src/dev-stop.ts",
    "rehearse:migration": "tsx src/rehearse-migration.ts",
    "cutover:import": "tsx src/cutover/run-import.ts",
    "shadow:run": "tsx src/cutover/run-shadow.ts",
    "shadow:sign-off": "tsx src/cutover/sign-off-shadow.ts",
    "staff:seed": "tsx src/admin/run-admin-command.ts staff-seed",
    "staff:password": "tsx src/admin/run-admin-command.ts staff-password",
    "staff:access": "tsx src/admin/run-admin-command.ts staff-access",
    "campaign:create": "tsx src/admin/run-admin-command.ts campaign-create",
    "customer:merge": "tsx src/admin/run-admin-command.ts customer-merge",
    "link-queue:resume": "tsx src/admin/run-admin-command.ts link-queue resume",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cashback/contracts": "workspace:*",
    "@cashback/core": "workspace:*",
    "@cashback/labels": "workspace:*",
    "@cashback/money": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cashback/golden": "workspace:*",
    "@types/better-sqlite3": "9.6.0"
  }
}
