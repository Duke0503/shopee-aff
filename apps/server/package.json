    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.36.4",
    "fastify": "5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
