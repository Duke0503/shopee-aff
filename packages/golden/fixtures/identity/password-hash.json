{
  "rule": "password_hash",
  "source": "src/cashback/core/accounts.py::hash_password / _hash_token",
  "cases": [
    {
      "name": "PBKDF2-SHA256, 240,000 rounds, fixed salt — Python produces exactly this string",
      "input": { "password": "ABCDEFGH", "salt": "00112233445566778899aabbccddeeff" },
      "expected": {
        "stored": "pbkdf2$240000$00112233445566778899aabbccddeeff$f7a2fb170bc2e827570e8742f27b08e6a4511332e5cd386e4948a6073c5c296d",
        "verifies": true
      }
    },
    {
      "name": "SHA-256 session token hash",
      "input": { "token": "example-session-token" },
      "expected": { "hash": "a25f92029ce6395795693e61e343b9057828af74ac72eaaff61c2e875bf4d5d6" }
    }
  ]
}
