        "expected_monthly_commission": 9000000
      },
      "expected": { "count": 3 }
    },
    {
      "name": "user_absorbs, 500,000d/month swings around the threshold (2 warnings)",
      "input": {
        "tax_policy": "user_absorbs",
        "cashback_rate": 0.8,
        "expected_monthly_commission": 500000
      },
      "expected": { "count": 2 }
    },
    {
      "name": "owner_absorbs never warns",
      "input": {
        "tax_policy": "owner_absorbs",
        "cashback_rate": 0.8,
        "expected_monthly_commission": 9000000
      },
      "expected": { "count": 0 }
    }
  ]
}
